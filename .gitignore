# Byte-compiled / build output
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/

# Runtime data — never commit a user's library or keys
data/
projects/
out/
logs/
bin/
.venv-tts/
*.db
*.db-wal
*.db-shm

# The starter b-roll and music pads are generated by packaging/build_media.py and
# committed (they are ours, not third-party stock). Anything a user drops in later
# is theirs and is not tracked.
assets/photos/*
assets/broll/user-*
assets/music/user-*

# OS noise
.DS_Store
Thumbs.db
desktop.ini
